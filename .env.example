# Copy to .env (or set as real environment variables) and fill in.

# --- Grist (optional: leave GRIST_API_KEY blank to run the dashboard without sync)
GRIST_API_KEY=
# Your Grist host, optionally with the team path. Either form works:
#   https://grist.example.com            https://grist.example.com/o/eisv2
GRIST_SERVER=
# EIS OVERALL [UPDATED]
GRIST_DOC_ID=hvoLt8XVgH1nGhrV7KAH6B
GRIST_SYNC_INTERVAL_S=30
GRIST_MAP_REFRESH_S=600

# --- Panels
# Leave PANELS_FILE / HISTORY_DB unset in Docker/Dokploy: the image points them at the /data volume.
# For a local (non-Docker) run the defaults are ./panels.yaml and ./history.db.
# PANELS_FILE=/data/panels.yaml
POLL_INTERVAL_S=5
POLL_TIMEOUT_S=3
OFFLINE_AFTER_FAILURES=3

# --- History for the /stats charts (SQLite)
# HISTORY_DB=/data/history.db
HISTORY_DAYS=90

# --- Web
# Required to add/edit/remove panels from the /panels page. Blank = edit panels.yaml only.
ADMIN_TOKEN=
HOST=0.0.0.0
PORT=8080
